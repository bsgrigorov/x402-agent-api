    "@x402-agent-api/shared": "workspace:*",
    "@x402-avm/extensions": "2.6.1",
    "@x402/avm": "2.21.0",
    "@x402/core": "2.21.0",
    "@x402/extensions": "2.21.0",
    "@x402/hono": "2.21.0",
    "hono": "4.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "algosdk": "3.5.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.119.0"
  }
