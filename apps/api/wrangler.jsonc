{
  "name": "x402-agent-api",
  // Personal Cloudflare account (brslv). Not a secret — pins deploy target.
  "account_id": "68dc41440ae5da6f6c21bfb160a117a5",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "env": {
    "dev": {
      "name": "x402-agent-api-dev",
      "workers_dev": true,
      "vars": {
        "NETWORK": "ALGORAND_Testnet_CAIP2",
        "BRIEF_PRICE_USDC": "0.05",
        "FACILITATOR_URL": "https://facilitator.goplausible.xyz"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "x402-agent-api-dev",
          "database_id": "2ddb556a-199c-434f-b3b8-b615ecd76cf2",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": ["0 * * * *", "0 */6 * * *", "15 5 * * *"]
      }
    },
    "prod": {
      "name": "x402-agent-api-prod",
      "routes": [{ "pattern": "x402.darkhold.dev", "custom_domain": true }],
      "vars": {
        "NETWORK": "ALGORAND_Mainnet_CAIP2",
        "BRIEF_PRICE_USDC": "0.05",
        "FACILITATOR_URL": "https://facilitator.goplausible.xyz"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "x402-agent-api-prod",
          "database_id": "REPLACE_AFTER_WRANGLER_D1_CREATE",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": ["0 * * * *", "0 */6 * * *", "15 5 * * *"]
      }
    }
  }
}
