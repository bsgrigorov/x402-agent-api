{
  "name": "x402-agent-api",
  // Personal Cloudflare account (brslv). Not a secret — pins deploy target.
  "account_id": "68dc41440ae5da6f6c21bfb160a117a5",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "env": {
    "dev": {
      "name": "x402-agent-api-dev",
      "workers_dev": true,
      "vars": {
        "NETWORK": "ALGORAND_Testnet_CAIP2",
        "BRIEF_PRICE_USDC": "0.05",
        "FACILITATOR_URL": "https://facilitator.goplausible.xyz"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "x402-agent-api-dev",
          "database_id": "2ddb556a-199c-434f-b3b8-b615ecd76cf2",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    },
    "prod": {
      "name": "x402-agent-api-prod",
      // Host x402.darkhold.dev: custom domain attached in Cloudflare (dashboard). Omitting
      // `routes` here so account-scoped CI tokens can deploy without Zone Workers Routes.
      "vars": {
        "NETWORK": "ALGORAND_Mainnet_CAIP2",
        "BRIEF_PRICE_USDC": "0.05",
        "FACILITATOR_URL": "https://facilitator.goplausible.xyz"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "x402-agent-api-prod",
          "database_id": "f6c5148b-d583-46fe-82d2-fd00719afb51",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    }
  }
}
