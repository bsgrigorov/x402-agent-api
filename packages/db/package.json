{
  "name": "@x402-agent-api/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "echo 'no db unit tests yet'",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env=dev --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env=dev",
    "db:migrate:remote:prod": "wrangler d1 migrations apply DB --remote --env=prod"
  },
  "dependencies": {
    "@x402-agent-api/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "typescript": "5.9.3",
    "wrangler": "4.119.0"
  }
}
