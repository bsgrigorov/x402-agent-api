{
  "name": "x402-agent-api",
  "private": true,
  "packageManager": "pnpm@11.28.3+sha512.d49760a13b1755948775a5d4cb1bc4ba871ff2dc941adf851630d044ed722f9b5be8be57bef93166098c80c706bd612c282d05526dd1d0ae660188c086820f35",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "pnpm --filter @x402-agent-api/api dev",
    "dev:ingest": "pnpm --filter @x402-agent-api/ingest dev",
    "deploy:dev": "pnpm deploy:dev:api && pnpm deploy:dev:ingest",
    "deploy:dev:api": "pnpm --filter @x402-agent-api/api deploy:dev",
    "deploy:dev:ingest": "pnpm --filter @x402-agent-api/ingest deploy:dev",
    "deploy:prod": "pnpm deploy:prod:api && pnpm deploy:prod:ingest",
    "deploy:prod:api": "pnpm --filter @x402-agent-api/api deploy:prod",
    "deploy:prod:ingest": "pnpm --filter @x402-agent-api/ingest deploy:prod",
    "db:migrate:local": "pnpm --filter @x402-agent-api/db db:migrate:local",
    "db:migrate:remote": "pnpm --filter @x402-agent-api/db db:migrate:remote",
    "db:migrate:remote:prod": "pnpm --filter @x402-agent-api/db db:migrate:remote:prod",
    "hydrate": "tsx scripts/hydrate.ts",
    "wallets:generate": "tsx scripts/generate-wallets.ts",
    "wallets:new-payer": "tsx scripts/rotate-payer.ts",
    "wallets:opt-in": "tsx scripts/opt-in-usdc.ts",
    "wallets:check": "tsx scripts/check-accounts.ts",
    "e2e:pay-brief": "tsx scripts/e2e-pay-brief.ts"
  },
  "devDependencies": {
    "@x402/avm": "2.21.0",
    "@x402/fetch": "2.21.0",
    "algosdk": "3.5.2",
    "tsx": "4.20.5",
    "turbo": "2.9.16",
    "typescript": "5.9.3",
    "wrangler": "4.119.0"
  }
}
